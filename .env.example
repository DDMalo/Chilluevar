# Copy to .env (gitignored) and fill in only what you actually use.
# The assistant runs fully offline by default; everything here is optional.

# Google Calendar (issue #18)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Home Assistant (issue #20)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Web search (issue #19)
SEARCH_API_KEY=
